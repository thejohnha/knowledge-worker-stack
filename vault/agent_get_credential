#!/usr/bin/env bash
# agent_get_credential — read ONE value out of the agent vault (a KeePassXC database unlocked by a key file).
# Exact match or nothing: a typo or partial title exits 1 with zero bytes, never a near miss.
# A value only ever goes to stdout, to be piped into the program that needs it — never displayed.
set -euo pipefail

DB=${CRED_DB:-$HOME/agent-vault/agent-vault.kdbx}
KF=${CRED_KEYFILE:-$HOME/.config/agent-vault/agent-vault.keyx}
KP=${CRED_KEEPASSXC_CLI:-$(command -v keepassxc-cli || echo /Applications/KeePassXC.app/Contents/MacOS/keepassxc-cli)}

die() { printf 'agent_get_credential: %s\n' "$1" >&2; exit 1; }

# Quiet, key-file-only, and never reads the caller's stdin, so it can never stop to prompt.
kp() { local sub=$1; shift; "$KP" "$sub" -q --no-password -k "$KF" "$@" </dev/null; }

usage() {
  cat >&2 <<'EOF'
agent_get_credential '<entry>'                 the password
agent_get_credential '<entry>' <attribute>     username / url / any custom attribute
agent_get_credential totp '<entry>'            the current 6-digit code
agent_get_credential hash '<entry>' [<attr>]   first 8 chars of a sha256: proves you have the right value without showing it
agent_get_credential list                      every entry title (cannot show a value)
agent_get_credential find <text>               entry titles containing text, any case (cannot show a value)

Titles are the FULL entry title, case-sensitive; start from list or find.
The Notes field is always refused, in any case: it is free text, and reading it to see what is in it is the leak.
find matches titles only, so it cannot answer questions about a password or a note; field prefixes (n:, p:) are refused.
EOF
  exit 1
}

# keepassxc-cli matches attribute names in any case, so Notes and NOTES are the notes field too.
is_notes() { [ "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" = notes ]; }

# Empty counts as a miss: a program handed an empty password reports a login failure, not a lookup failure.
get() {
  local entry=$1 attr=$2 v
  is_notes "$attr" && die "Notes is never read by an agent; ask for the field you need by name"
  v=$(kp show -a "$attr" -s "$DB" "$entry" 2>/dev/null) || die "no entry titled '$entry' with attribute '$attr'"
  [ -n "$v" ] || die "'$entry' has '$attr' but it is empty"
  printf '%s\n' "$v"
}

[ $# -ge 1 ] || usage
[ -r "$KF" ] || die "key file not readable: $KF"
[ -r "$DB" ] || die "vault not readable: $DB"

case "$1" in
  list) [ $# -eq 1 ] || usage; kp ls -R -f "$DB" ;;
  find)
    [ $# -eq 2 ] || usage
    # Not keepassxc-cli search: a plain term there also matches notes, username and url, and a prefix
    # (n:, p:, or any attribute name) searches that field, so a yes/no answer leaks a value bit by bit.
    prefix='(^|[[:space:]])[-!*+]*[[:alnum:]_]+:[^[:space:]]'
    [[ $2 =~ $prefix ]] && die "find matches titles only; field prefixes like n: or p: are refused"
    out=$(kp ls -R -f "$DB" 2>/dev/null | grep -v '/$' | grep -iF -- "$2") || die "no entry matches '$2'"
    printf '%s\n' "$out" ;;
  totp)
    [ $# -eq 2 ] || usage
    v=$(kp show -t "$DB" "$2" 2>/dev/null) && [ -n "$v" ] || die "no TOTP for '$2'"
    printf '%s\n' "$v" ;;
  hash)
    [ $# -ge 2 ] && [ $# -le 3 ] || usage
    is_notes "${3:-}" && die "Notes is never read by an agent"
    v=$(kp show -a "${3:-password}" -s "$DB" "$2" 2>/dev/null) && [ -n "$v" ] || die "no such entry or attribute"
    printf '%s' "$v" | shasum -a 256 | cut -c1-8 ;;
  -h|--help|help) usage ;;
  *) [ $# -le 2 ] || usage; get "$1" "${2:-password}" ;;
esac
